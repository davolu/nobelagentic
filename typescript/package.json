{
  "name": "nobelagentic",
  "version": "0.1.0",
  "description": "NobelAgentic — agents that get out of your way. One kernel, three APIs, any model.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "bin": { "nobelagentic": "./dist/cli.js" },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": ["agents", "llm", "ai", "mcp", "anthropic", "openai", "framework"],
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/davolu/nobelagentic" },
  "homepage": "https://github.com/davolu/nobelagentic#readme",
  "engines": { "node": ">=18" },
  "dependencies": {
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.23.0"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.50.0",
    "openai": "^4.80.0",
    "@modelcontextprotocol/sdk": "^1.10.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.0.0"
  }
}
